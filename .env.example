# Speech-to-text for voice recordings, via Groq's free-tier hosted Whisper
# (OpenAI-compatible endpoint). This app has no other server-side AI calls —
# mood/trend "AI help" is a local, on-device Prompt generator
# (src/lib/aiPrompt.ts) you copy into whatever AI you use yourself; nothing
# is sent from this app for that feature.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Daily 22:00 (Asia/Taipei) reminder email, sent via Resend.
# Get a key at https://resend.com/
RESEND_API_KEY=
# Must be a domain you've verified in Resend, or the Resend sandbox address
# onboarding@resend.dev (only deliverable to your own Resend account email
# while unverified).
RESEND_FROM_EMAIL=onboarding@resend.dev
# Overrides the reminder recipient hardcoded in the spec (clchrf.lee@gmail.com).
REMINDER_EMAIL_TO=

# Absolute URL of the deployed app, used for the "記錄今天" link inside the
# reminder email (e.g. https://cat-diary.vercel.app).
APP_URL=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# calling /api/email/send. Set the same value in your Vercel project's Cron
# settings. Leave unset only for local testing.
CRON_SECRET=
